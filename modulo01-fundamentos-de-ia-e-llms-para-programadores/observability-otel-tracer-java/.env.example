# ── OpenTelemetry Collector endpoint (gRPC) ──────────────────────────────────
# The OTLP Collector listens on port 4317 (gRPC).
# This must match the port exposed by the docker-compose-infra.yaml in
# ../exemplo-09-grafana-mcp/alumnus/infra/
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Service name reported to the collector ────────────────────────────────────
# Appears as the "service.name" resource attribute in Tempo, Loki, and Prometheus.
SERVICE_NAME=java-ecommerce
